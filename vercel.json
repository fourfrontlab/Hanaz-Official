{
    "headers": [
        {
            "source": "/images/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/css/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/js/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/collections/frontpage",
            "destination": "/products.html",
            "permanent": true
        },
        {
            "source": "/collections",
            "destination": "/collections.html",
            "permanent": true
        },
        {
            "source": "/collections/:match*",
            "destination": "/collections.html",
            "permanent": true
        },
        {
            "source": "/products/:match*",
            "destination": "/products.html",
            "permanent": true
        },
        {
            "source": "/pages/contact-us",
            "destination": "/contact.html",
            "permanent": true
        },
        {
            "source": "/pages/about-us",
            "destination": "/about.html",
            "permanent": true
        }
    ]
}